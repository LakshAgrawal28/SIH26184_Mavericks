FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends binutils && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --timeout 60 -r /app/backend/requirements.txt

COPY backend /app/backend
COPY scanner /app/scanner

ENV PYTHONPATH=/app/backend:/app
WORKDIR /app/backend

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "from app.workers.celery_app import celery_app; celery_app.control.inspect().ping()" || exit 1

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
