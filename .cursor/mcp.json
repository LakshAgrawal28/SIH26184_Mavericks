{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp",
        "--cwd",
        "${workspaceFolder}/frontend"
      ]
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${env:API_KEY_21ST}"
      }
    }
  }
}
