# Backend API base URL (no trailing slash). All scans are created/read via this API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — not used for scan storage today (auth is backend JWT via /api/v1/auth).
# To persist scans in Supabase, set DATABASE_URL on the API service to Supabase’s
# Postgres URI (see root .env.example); do not expect rows in Supabase from these vars alone.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
