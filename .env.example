# =============================================================================
# TEMPLATE ONLY — copy to `.env` before running Docker Compose or deploying:
#   cp .env.example .env
# Replace every secret below (passwords, JWT_SECRET, MinIO keys) with strong
# unique values. Never commit `.env` or use these defaults outside local dev.
# =============================================================================
# ECDAT Environment Configuration
POSTGRES_USER=ecdat
POSTGRES_PASSWORD=ecdat_secret
POSTGRES_DB=ecdat
# Docker Compose (local stack)
DATABASE_URL=postgresql+psycopg2://ecdat:ecdat_secret@postgres:5432/ecdat
# Supabase: Project Settings → Database → URI (use postgresql://…; app adds psycopg2 + sslmode=require)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ecdat_minio
MINIO_SECRET_KEY=ecdat_minio_secret
MINIO_BUCKET=ecdat-scans
MINIO_SECURE=false

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEFAULT_ADMIN_EMAIL=admin@example.com
# Local demo: set to admin123. Omit on first deploy to auto-generate a random password (logged once at startup).
DEFAULT_ADMIN_PASSWORD=admin123

FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ecdat-zeta.vercel.app

SCAN_MAX_BYTES=524288000
SCAN_WORK_DIR=/tmp/ecdat-scans
SYNC_SCAN=false

# Optional E10 — Groq narration (off by default; core scans work without it)
AI_NARRATION_ENABLED=true
GROQ_API_KEY=
# openai/gpt-oss-20b uses fewer tokens on free tier; qwen/qwen3.8-27b for quality if limits allow
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CONTEXT_ARTEFACT_LIMIT=40

# Optional — Cursor 21st.dev MCP (.cursor/mcp.json). Create key at https://21st.dev/settings/api-keys
# Also export in your shell (or launchctl setenv on macOS) so Cursor can resolve ${env:API_KEY_21ST}.
API_KEY_21ST=
